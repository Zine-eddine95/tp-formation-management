# Environnement de TEST
PORT=3002
NODE_ENV=test

# Base de données SQLite (tests isolés, pas besoin de MySQL)
DB_DIALECT=sqlite
DB_STORAGE=:memory:

# JWT
JWT_SECRET=test_jwt_secret_not_secure
JWT_EXPIRATION=1h

# Email (désactivé en test)
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_USER=test@localhost
EMAIL_PASSWORD=test

# API Publique
PUBLIC_API_KEY=test_api_key_12345

# Application
APP_NAME=Formation Management (Test)
APP_URL=http://localhost:3002
