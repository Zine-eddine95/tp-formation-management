# Environnement de STAGING (pré-production)
PORT=3001
NODE_ENV=staging

# Base de données MySQL (staging)
DB_HOST=127.0.0.1
DB_USER=app_user
DB_PASSWORD=CHANGEME_STAGING_PASSWORD
DB_NAME=gestion_formation_staging
DB_PORT=3306
DB_DIALECT=mysql

# JWT
JWT_SECRET=CHANGEME_JWT_SECRET_STAGING
JWT_EXPIRATION=24h

# Email (boîte de test staging)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=staging-email@votredomaine.com
EMAIL_PASSWORD=CHANGEME_EMAIL_PASSWORD

# API Publique
PUBLIC_API_KEY=CHANGEME_STAGING_API_KEY

# Application
APP_NAME=Formation Management (Staging)
APP_URL=https://staging.votredomaine.com
